}

.popular-badge i {
    color: #FFD700;
    margin-right: 2px;
}

.pricing-card.popular-service {
    border: 2px solid var(--color-teal);
    position: relative;
    box-shadow: 0 5px 15px rgba(64, 124, 115, 0.15);
}

.pricing-card.popular-service:hover {
